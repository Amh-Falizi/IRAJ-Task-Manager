# SECRET_KEY: Secret string used to sign and verify JWT authentication tokens
SECRET_KEY=""

# TOKEN_ENCRYPTION_KEY: Dedicated secret string used to encrypt Git Personal Access Tokens (PATs) at rest.
# Required in production. Minimum 16 characters.
TOKEN_ENCRYPTION_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL database connection string
DATABASE_URL="postgres://user:password@localhost:5432/dbname"

# Local Docker Postgres Configuration (for local docker-compose setup)
POSTGRES_USER="devuser"
POSTGRES_PASSWORD="devpassword"
POSTGRES_DB="devdb"

# Application Settings
HOST="0.0.0.0"
PORT="3000"
# TRUST_PROXY: Reverse proxy trust configuration ('loopback', hop count like '1', or specific IP/CIDR).
# Defaults to 'loopback' to prevent peer containers on private networks from spoofing headers.
# IMPORTANT: When deploying behind a reverse proxy, ingress gateway, or load balancer (Nginx, Traefik, AWS ALB, Cloud Run),
# set this to the upstream hop count (e.g. '1') or the proxy's IP/subnet so client IPs in X-Forwarded-For are recognized
# and not collapsed into a single rate-limit bucket. Ensure the proxy is configured to overwrite X-Forwarded-For rather than appending.
# NOTE: Avoid setting to 'true' as it blindly trusts all hops and enables client IP spoofing; 'false' disables proxy trust entirely.
TRUST_PROXY="loopback"
VITE_APP_NAME="ProjectManager"
VITE_APP_VERSION="1.0.0"
VITE_GIT_ENABLED="true" # Feature flag to toggle Git repositories and integrations (set to 'false' to disable)

# GitLab OAuth Integration
GITLAB_URL="https://gitlab.com"
GITLAB_CLIENT_ID=""
GITLAB_CLIENT_SECRET=""

# Google OAuth Integration
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth Integration
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# OAuth Access Control (Optional)
# Restrict OAuth registration to specific domains (e.g. 'company.com,subsidiary.com')
# OAUTH_ALLOWED_DOMAINS=""
# Set to 'false' to disable self-registration via OAuth providers (default in production)
# OAUTH_AUTO_REGISTER="false"

# Local Self-Registration Policy
# - 'false': Public registration is closed; all accounts must be created by administrators.
# - 'true': If SMTP is configured, new accounts require email verification link.
#           If SMTP is not configured, new accounts require administrator approval.
ALLOW_SELF_REGISTRATION="true"

# API Settings
VITE_API_URL="/api"

# SMTP Settings for Emails (Optional)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@example.com"

